# ArchiScrapping Configuration
# Copy this file to .env and fill in your values

# Database (SQLite by default, can use PostgreSQL on Railway)
DATABASE_URL=sqlite:///./archiscrapping.db

# Scraping Configuration
SCRAPE_INTERVAL_HOURS=6
RESULTS_PER_SITE=50

# Search terms (comma-separated)
SEARCH_TERMS=Architekt,Architect,Architektin,Senior Architekt,Projektleiter Architektur,Bauzeichner,Entwurfsarchitekt

# Proxies (comma-separated, format: user:pass@host:port)
# PROXY_LIST=proxy1:port,proxy2:port
PROXY_LIST=

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Telegram Notifications
# Create a bot with @BotFather to get the token
TELEGRAM_BOT_TOKEN=
# Get your Chat ID from @userinfobot or https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
